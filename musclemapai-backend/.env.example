# Recommended free provider for AI responses
GROQ_API_KEY=

# Optional model settings (these defaults are recommended for this app)
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=medium

# Free runtime fallback for Groq rate limits and transient provider errors
AGNES_API_KEY=
AGNES_MODEL=agnes-2.5-flash

# Optional paid fallback when no Groq key is configured
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
CEREBRAS_REASONING_EFFORT=medium

# Recommended for durable backend memory across serverless invocations
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
