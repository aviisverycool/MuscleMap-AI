# Recommended free provider for AI responses
GROQ_API_KEY=

# Optional model settings (these defaults are recommended for this app)
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Free runtime fallback for Groq rate limits and transient provider errors
AGNES_API_KEY=
AGNES_MODEL=agnes-2.5-flash

# Optional paid fallback when no Groq key is configured
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b

# Required for token validation, durable memory, account deletion, and shared
# rate limiting. Keep the service-role key server-side only.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional exact cross-origin frontend URLs, comma-separated. Same-origin
# production requests do not need an entry here.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
APP_ENV=development
