# Optional override. Leave unset in Vercel to use the same-origin /api service.
VITE_API_URL=http://localhost:8000/api

# Shared demo login alias used by the app. Set this to the confirmed Supabase
# email you want the `demo` alias to resolve to.
VITE_DEMO_ACCOUNT_EMAIL=

# The app currently falls back to its existing public Supabase project values.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SITE_URL=
