# Optional override. Leave unset in Vercel to use the same-origin /api service.
VITE_API_URL=http://localhost:8000/api

# Optional override for the shared demo login alias. The app defaults to the
# confirmed Supabase account used by CAC judges, so this normally stays unset.
VITE_DEMO_ACCOUNT_EMAIL=

# The app currently falls back to its existing public Supabase project values.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SITE_URL=
